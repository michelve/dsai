        "$value": "{colors.brand.gray.100}",
        "$type": "color",
        "$description": "Neutral gray 100 alias. References brand.gray.100. Use for consistent gray tones across light/Darks. Maintains semantic meaning while adapting to theme context. See brand.gray.100 for detailed usage guidance.",
        "$extensions": {
          "docs": {
            "reference": "https://getbootstrap.com/docs/5.3/customize/color/#grays"
          },
          "platform": {
            "scssVariableName": "$color-gray-100"
          }
        },
        "$scopes": ["ALL_FILLS", "STROKE_COLOR"],
        "$codeSyntax": {
          "WEB": "--dsai-color-gray-100",
          "ANDROID": "neutral.gray.100",
          "iOS": "Neutral.Gray.100"
        },
        "comment": "$color-gray-100"
      },
