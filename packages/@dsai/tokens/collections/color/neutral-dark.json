{
  "neutral": {
    "white": {
      "$value": "#0a0d10",
      "$type": "color",
      "$description": "Soft white (#FAFBFC / gray-50). Primary background for Light mode. Use for cards, page backgrounds, and surfaces. Reduces eye strain compared to pure white. WCAG AAA compliant with gray-900 text.",
      "$extensions": {
        "docs": {
          "reference": "https://getbootstrap.com/docs/5.3/customize/color/#grays"
        },
        "platform": {
          "scssVariableName": "$neutral-white"
        }
      },
      "$scopes": ["ALL_FILLS"],
      "$codeSyntax": {
        "WEB": "--dsai-neutral-white",
        "ANDROID": "color.white",
        "iOS": "Color.White"
      },
      "comment": "$neutral-white"
    },
    "black": {
      "$value": "#fafbfc",
      "$type": "color",
      "$description": "Near-black (#0A0D10 / gray-950). Maximum emphasis for Light mode. Use for headings, high-contrast text, and critical UI. Softer than pure black, reduces eye strain. WCAG AAA compliant on white backgrounds.",
      "$extensions": {
        "docs": {
          "reference": "https://getbootstrap.com/docs/5.3/customize/color/#grays"
        },
        "platform": {
          "scssVariableName": "$neutral-black"
        }
      },
      "$scopes": ["ALL_FILLS"],
      "$codeSyntax": {
        "WEB": "--dsai-neutral-black",
        "ANDROID": "neutral.black",
        "iOS": "Neutral.Black"
      },
      "comment": "$neutral-black"
    },
    "gray": {
