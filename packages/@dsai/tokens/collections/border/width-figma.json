{
  "border": {
    "width": {
      "thin": {
        "$value": "1px",
        "$type": "dimension",
        "$extensions": {
          "docs": {
            "reference": "https://getbootstrap.com/docs/5.3/utilities/borders/#width"
          },
          "platform": {
            "scssVariableName": "$border-widths",
            "bootstrapVersion": "5.3"
          }
        },
        "$scopes": ["STROKE_FLOAT"],
        "comment": "$border-widths"
      },
      "medium": {
        "$value": "2px",
        "$type": "dimension",
        "$extensions": {
          "docs": {
            "reference": "https://getbootstrap.com/docs/5.3/utilities/borders/#width"
          },
          "platform": {
            "scssVariableName": "$border-widths",
            "bootstrapVersion": "5.3"
          }
        },
        "$scopes": ["STROKE_FLOAT"],
        "comment": "$border-widths"
      },
      "thick": {
        "$value": "4px",
        "$type": "dimension",
        "$extensions": {
          "docs": {
            "reference": "https://getbootstrap.com/docs/5.3/utilities/borders/#width"
          },
          "platform": {
            "scssVariableName": "$border-widths",
            "bootstrapVersion": "5.3"
          }
        },
        "$scopes": ["STROKE_FLOAT"],
        "comment": "$border-widths"
      },
      "default": {
        "$value": "{borders.width.thin}",
        "$type": "dimension",
        "$extensions": {
          "docs": {
            "reference": "https://getbootstrap.com/docs/5.3/utilities/borders/#width",
            "section": "Utilities",
            "subsection": "Borders – Border Width"
          },
          "platform": {
            "scssVariableName": "$border-width",
            "bootstrapVersion": "5.3"
          }
        },
        "$scopes": ["STROKE_FLOAT"],
        "comment": "$border-width"
      },
      "none": {
        "$value": "0px",
        "$type": "dimension",
        "$description": "No border",
        "$scopes": ["STROKE_FLOAT", "FONT_VARIATIONS"]
      }
    }
  }
}
