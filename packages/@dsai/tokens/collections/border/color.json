{
  "border": {
    "color": {
      "default": {
        "$value": "{colors.neutral.gray.300}",
        "$type": "color",
        "$extensions": {
          "platform": {
            "scssVariableName": "$border-color-default"
          }
        },
        "$scopes": ["STROKE_COLOR"],
        "$codeSyntax": {
          "WEB": "--dsai-border-color-default",
          "ANDROID": "border.color.default",
          "iOS": "Border.Color.Default"
        },
        "comment": "$border-color-default"
      }
    }
  }
}
