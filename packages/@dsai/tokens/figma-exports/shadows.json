{
  "Shadows": {
    "modes": {
      "Base": {
        "shadows": {
          "default": {
            "color": {
              "$value": "{semantic.emphasis-color}",
              "$type": "color",
              "$description": "Shadow color for default elevation",
              "$codeSyntax": {
                "WEB": "--dsai-shadow-default-color",
                "ANDROID": "shadow.default.color",
                "iOS": "Shadow.Default.Color"
              },
              "$scopes": ["EFFECT_COLOR"]
            },
            "offsetX": {
              "$value": 0,
              "$type": "number",
              "$description": "Shadow horizontal offset",
              "$codeSyntax": {
                "WEB": "--dsai-shadow-default-offset-x",
                "ANDROID": "shadow.default.offsetX",
                "iOS": "Shadow.Default.OffsetX"
              },
              "$scopes": ["EFFECT_FLOAT"]
            },
            "offsetY": {
              "$value": 8,
              "$type": "number",
              "$description": "Shadow vertical offset (0.5rem = 8px)",
              "$codeSyntax": {
                "WEB": "--dsai-shadow-default-offset-y",
                "ANDROID": "shadow.default.offsetY",
                "iOS": "Shadow.Default.OffsetY"
              },
              "$scopes": ["EFFECT_FLOAT"]
            },
            "blur": {
              "$value": 16,
              "$type": "number",
              "$description": "Shadow blur radius (1rem = 16px)",
              "$codeSyntax": {
                "WEB": "--dsai-shadow-default-blur",
                "ANDROID": "shadow.default.blur",
                "iOS": "Shadow.Default.Blur"
              },
              "$scopes": ["EFFECT_FLOAT"]
            },
            "spread": {
              "$value": 0,
              "$type": "number",
              "$description": "Shadow spread radius",
              "$codeSyntax": {
                "WEB": "--dsai-shadow-default-spread",
                "ANDROID": "shadow.default.spread",
                "iOS": "Shadow.Default.Spread"
              },
              "$scopes": ["EFFECT_FLOAT"]
            },
            "composite": {
              "$value": "0 0.5rem 1rem rgba(0, 0, 0, 0.15)",
              "$type": "string",
              "$description": "Complete box shadow value for Bootstrap SCSS export",
              "$extensions": {
                "docs": {
                  "reference": "https://getbootstrap.com/docs/5.3/utilities/shadows/"
                },
                "platform": {
                  "scssVariableName": "$box-shadow"
                }
              },
              "$codeSyntax": {
                "WEB": "--dsai-shadow-default",
                "ANDROID": "shadow.default",
                "iOS": "Shadow.Default"
              },
              "$scopes": ["TEXT_CONTENT"]
            }
          },
          "sm": {
            "color": {
              "$value": "{semantic.emphasis-color}",
              "$type": "color",
              "$description": "Shadow color for small elevation",
              "$codeSyntax": {
                "WEB": "--dsai-shadow-sm-color",
                "ANDROID": "shadow.sm.color",
                "iOS": "Shadow.Sm.Color"
              },
              "$scopes": ["EFFECT_COLOR"]
            },
            "offsetX": {
              "$value": 0,
              "$type": "number",
              "$description": "Shadow horizontal offset",
              "$codeSyntax": {
                "WEB": "--dsai-shadow-sm-offset-x",
                "ANDROID": "shadow.sm.offsetX",
                "iOS": "Shadow.Sm.OffsetX"
              },
              "$scopes": ["EFFECT_FLOAT"]
            },
            "offsetY": {
              "$value": 2,
              "$type": "number",
              "$description": "Shadow vertical offset (0.125rem = 2px)",
              "$codeSyntax": {
                "WEB": "--dsai-shadow-sm-offset-y",
                "ANDROID": "shadow.sm.offsetY",
                "iOS": "Shadow.Sm.OffsetY"
              },
              "$scopes": ["EFFECT_FLOAT"]
            },
            "blur": {
              "$value": 4,
              "$type": "number",
              "$description": "Shadow blur radius (0.25rem = 4px)",
              "$codeSyntax": {
                "WEB": "--dsai-shadow-sm-blur",
                "ANDROID": "shadow.sm.blur",
                "iOS": "Shadow.Sm.Blur"
              },
              "$scopes": ["EFFECT_FLOAT"]
            },
            "spread": {
              "$value": 0,
              "$type": "number",
              "$description": "Shadow spread radius",
              "$codeSyntax": {
                "WEB": "--dsai-shadow-sm-spread",
                "ANDROID": "shadow.sm.spread",
                "iOS": "Shadow.Sm.Spread"
              },
              "$scopes": ["EFFECT_FLOAT"]
            },
            "composite": {
              "$value": "0 0.125rem 0.25rem rgba(0, 0, 0, 0.075)",
              "$type": "string",
              "$description": "Complete box shadow value for Bootstrap SCSS export",
              "$extensions": {
                "docs": {
                  "reference": "https://getbootstrap.com/docs/5.3/utilities/shadows/"
                },
                "platform": {
                  "scssVariableName": "$box-shadow-sm"
                }
              },
              "$codeSyntax": {
                "WEB": "--dsai-shadow-sm",
                "ANDROID": "shadow.sm",
                "iOS": "Shadow.Sm"
              },
              "$scopes": ["TEXT_CONTENT"]
            }
          },
          "lg": {
            "color": {
              "$value": "#000000",
              "$type": "color",
              "$description": "Shadow color for large elevation",
              "$codeSyntax": {
                "WEB": "--dsai-shadow-lg-color",
                "ANDROID": "shadow.lg.color",
                "iOS": "Shadow.Lg.Color"
              },
              "$scopes": ["EFFECT_COLOR"]
            },
            "offsetX": {
              "$value": 0,
              "$type": "number",
              "$description": "Shadow horizontal offset",
              "$codeSyntax": {
                "WEB": "--dsai-shadow-lg-offset-x",
                "ANDROID": "shadow.lg.offsetX",
                "iOS": "Shadow.Lg.OffsetX"
              },
              "$scopes": ["EFFECT_FLOAT"]
            },
            "offsetY": {
              "$value": 16,
              "$type": "number",
              "$description": "Shadow vertical offset (1rem = 16px)",
              "$codeSyntax": {
                "WEB": "--dsai-shadow-lg-offset-y",
                "ANDROID": "shadow.lg.offsetY",
                "iOS": "Shadow.Lg.OffsetY"
              },
              "$scopes": ["EFFECT_FLOAT"]
            },
            "blur": {
              "$value": 48,
              "$type": "number",
              "$description": "Shadow blur radius (3rem = 48px)",
              "$codeSyntax": {
                "WEB": "--dsai-shadow-lg-blur",
                "ANDROID": "shadow.lg.blur",
                "iOS": "Shadow.Lg.Blur"
              },
              "$scopes": ["EFFECT_FLOAT"]
            },
            "spread": {
              "$value": 0,
              "$type": "number",
              "$description": "Shadow spread radius",
              "$codeSyntax": {
                "WEB": "--dsai-shadow-lg-spread",
                "ANDROID": "shadow.lg.spread",
                "iOS": "Shadow.Lg.Spread"
              },
              "$scopes": ["EFFECT_FLOAT"]
            },
            "composite": {
              "$value": "0 1rem 3rem rgba(0, 0, 0, 0.175)",
              "$type": "string",
              "$description": "Complete box shadow value for Bootstrap SCSS export",
              "$extensions": {
                "docs": {
                  "reference": "https://getbootstrap.com/docs/5.3/utilities/shadows/"
                },
                "platform": {
                  "scssVariableName": "$box-shadow-lg"
                }
              },
              "$codeSyntax": {
                "WEB": "--dsai-shadow-lg",
                "ANDROID": "shadow.lg",
                "iOS": "Shadow.Lg"
              },
              "$scopes": ["TEXT_CONTENT"]
            }
          },
          "inset": {
            "color": {
              "$value": "#000000",
              "$type": "color",
              "$description": "Shadow color for inset effect",
              "$codeSyntax": {
                "WEB": "--dsai-shadow-inset-color",
                "ANDROID": "shadow.inset.color",
                "iOS": "Shadow.Inset.Color"
              },
              "$scopes": ["EFFECT_COLOR"]
            },
            "offsetX": {
              "$value": 0,
              "$type": "number",
              "$description": "Shadow horizontal offset",
              "$codeSyntax": {
                "WEB": "--dsai-shadow-inset-offset-x",
                "ANDROID": "shadow.inset.offsetX",
                "iOS": "Shadow.Inset.OffsetX"
              },
              "$scopes": ["EFFECT_FLOAT"]
            },
            "offsetY": {
              "$value": 1,
              "$type": "number",
              "$description": "Shadow vertical offset (1px)",
              "$codeSyntax": {
                "WEB": "--dsai-shadow-inset-offset-y",
                "ANDROID": "shadow.inset.offsetY",
                "iOS": "Shadow.Inset.OffsetY"
              },
              "$scopes": ["EFFECT_FLOAT"]
            },
            "blur": {
              "$value": 2,
              "$type": "number",
              "$description": "Shadow blur radius (2px)",
              "$codeSyntax": {
                "WEB": "--dsai-shadow-inset-blur",
                "ANDROID": "shadow.inset.blur",
                "iOS": "Shadow.Inset.Blur"
              },
              "$scopes": ["EFFECT_FLOAT"]
            },
            "spread": {
              "$value": 0,
              "$type": "number",
              "$description": "Shadow spread radius",
              "$codeSyntax": {
                "WEB": "--dsai-shadow-inset-spread",
                "ANDROID": "shadow.inset.spread",
                "iOS": "Shadow.Inset.Spread"
              },
              "$scopes": ["EFFECT_FLOAT"]
            },
            "composite": {
              "$value": "inset 0 1px 2px rgba(0, 0, 0, 0.075)",
              "$type": "string",
              "$description": "Complete box shadow value for Bootstrap SCSS export",
              "$extensions": {
                "docs": {
                  "reference": "https://getbootstrap.com/docs/5.3/utilities/shadows/"
                },
                "platform": {
                  "scssVariableName": "$box-shadow-inset"
                }
              },
              "$codeSyntax": {
                "WEB": "--dsai-shadow-inset",
                "ANDROID": "shadow.inset",
                "iOS": "Shadow.Inset"
              },
              "$scopes": ["TEXT_CONTENT"]
            }
          }
        }
      }
    }
  }
}
