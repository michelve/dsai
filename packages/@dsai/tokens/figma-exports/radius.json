{
  "Radius": {
    "modes": {
      "Base": {
        "radius": {
          "none": {
            "$value": 0,
            "$type": "number",
            "$description": "Border radius: 0 - No rounding. Used for completely square corners. Equivalent to Bootstrap's 'rounded-0' utility class.",
            "$extensions": {
              "docs": {
                "reference": "https://getbootstrap.com/docs/5.3/utilities/borders/#radius"
              },
              "platform": {
                "scssVariableName": "$border-radius-none"
              }
            },
            "$codeSyntax": {
              "WEB": "--dsai-border-radius-none",
              "ANDROID": "border.radius.none",
              "iOS": "Border.Radius.None"
            },
            "$scopes": ["CORNER_RADIUS"]
          },
          "sm": {
            "$value": 4,
            "$type": "number",
            "$description": "Border radius: Small - .25rem (4px). Used for subtle rounding on small components. Equivalent to Bootstrap's 'rounded-1' utility class and $border-radius-sm variable.",
            "$extensions": {
              "docs": {
                "reference": "https://getbootstrap.com/docs/5.3/utilities/borders/#sizes"
              },
              "platform": {
                "scssVariableName": "$border-radius-sm"
              }
            },
            "$codeSyntax": {
              "WEB": "--dsai-border-radius-sm",
              "ANDROID": "border.radius.sm",
              "iOS": "Border.Radius.Sm"
            },
            "$scopes": ["CORNER_RADIUS"]
          },
          "md": {
            "$value": 8,
            "$type": "number",
            "$description": "Border radius: Default - 0.5rem (8px). The standard rounding used throughout Bootstrap for most components. Equivalent to Bootstrap's 'rounded' or 'rounded-2' utility classes and $border-radius variable.",
            "$extensions": {
              "docs": {
                "reference": "https://getbootstrap.com/docs/5.3/utilities/borders/#radius"
              },
              "platform": {
                "scssVariableName": "$border-radius"
              }
            },
            "$codeSyntax": {
              "WEB": "--dsai-border-radius-md",
              "ANDROID": "border.radius.md",
              "iOS": "Border.Radius.Md"
            },
            "$scopes": ["CORNER_RADIUS"]
          },
          "lg": {
            "$value": 16,
            "$type": "number",
            "$description": "Border radius: Large - 1rem (16px). Used for larger, more prominent rounded corners. Equivalent to Bootstrap's 'rounded-3' utility class and $border-radius-lg variable.",
            "$extensions": {
              "docs": {
                "reference": "https://getbootstrap.com/docs/5.3/utilities/borders/#sizes"
              },
              "platform": {
                "scssVariableName": "$border-radius-lg"
              }
            },
            "$codeSyntax": {
              "WEB": "--dsai-border-radius-lg",
              "ANDROID": "border.radius.lg",
              "iOS": "Border.Radius.Lg"
            },
            "$scopes": ["CORNER_RADIUS"]
          },
          "xl": {
            "$value": 24,
            "$type": "number",
            "$description": "Border radius: Extra Large - 1.5rem (24px). Used for very prominent rounded corners on large components. Equivalent to Bootstrap's 'rounded-4' utility class and $border-radius-xl variable.",
            "$extensions": {
              "docs": {
                "reference": "https://getbootstrap.com/docs/5.3/utilities/borders/#sizes"
              },
              "platform": {
                "scssVariableName": "$border-radius-xl"
              }
            },
            "$codeSyntax": {
              "WEB": "--dsai-border-radius-xl",
              "ANDROID": "border.radius.xl",
              "iOS": "Border.Radius.Xl"
            },
            "$scopes": ["CORNER_RADIUS"]
          },
          "xxl": {
            "$value": 32,
            "$type": "number",
            "$description": "Border radius: 2X Extra Large - 2rem (32px). Used for dramatically rounded corners creating a softer, more modern appearance. Equivalent to Bootstrap's 'rounded-5' utility class and $border-radius-xxl variable.",
            "$extensions": {
              "docs": {
                "reference": "https://getbootstrap.com/docs/5.3/utilities/borders/#sizes"
              },
              "platform": {
                "scssVariableName": "$border-radius-xxl"
              }
            },
            "$codeSyntax": {
              "WEB": "--dsai-border-radius-xxl",
              "ANDROID": "border.radius.xxl",
              "iOS": "Border.Radius.Xxl"
            },
            "$scopes": ["CORNER_RADIUS"]
          },
          "full": {
            "$value": 9999,
            "$type": "number",
            "$description": "Border radius: Full - 624.9375rem (9999px). Creates fully rounded corners for any size element. Used internally for completely rounded shapes.",
            "$extensions": {
              "docs": {
                "reference": "https://getbootstrap.com/docs/5.3/utilities/borders/#sizes"
              },
              "platform": {
                "scssVariableName": "$border-radius-full"
              }
            },
            "$codeSyntax": {
              "WEB": "--dsai-border-radius-full",
              "ANDROID": "border.radius.full",
              "iOS": "Border.Radius.Full"
            },
            "$scopes": ["CORNER_RADIUS"]
          },
          "circle": {
            "$value": 100000000,
            "$type": "number",
            "$description": "Border radius: Circle - 50%. Creates perfectly circular shapes when applied to square elements. Equivalent to Bootstrap's 'rounded-circle' utility class. Note: This is a percentage value (50%), not pixel-based.",
            "$extensions": {
              "docs": {
                "reference": "https://getbootstrap.com/docs/5.3/utilities/borders/#sizes"
              },
              "platform": {
                "scssVariableName": "$border-radius-circle"
              }
            },
            "$codeSyntax": {
              "WEB": "--dsai-border-radius-circle",
              "ANDROID": "border.radius.circle",
              "iOS": "Border.Radius.Circle"
            },
            "$scopes": ["CORNER_RADIUS"]
          },
          "pill": {
            "$value": 800,
            "$type": "number",
            "$description": "Border radius: Pill - 50rem (800px). Creates pill-shaped elements with fully rounded ends on rectangular shapes. Equivalent to Bootstrap's 'rounded-pill' utility class and $border-radius-pill variable.",
            "$extensions": {
              "docs": {
                "reference": "https://getbootstrap.com/docs/5.3/utilities/borders/#sizes"
              },
              "platform": {
                "scssVariableName": "$border-radius-pill"
              }
            },
            "$codeSyntax": {
              "WEB": "--dsai-border-radius-pill",
              "ANDROID": "border.radius.pill",
              "iOS": "Border.Radius.Pill"
            },
            "$scopes": ["CORNER_RADIUS"]
          }
        }
      }
    }
  }
}
