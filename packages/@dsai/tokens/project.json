{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "@dsai/tokens",
  "sourceRoot": "packages/@dsai/tokens/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["validate", "^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          "style-dictionary build --config sd.config.mjs",
          "dsai tokens sync",
          "pnpm build:theme",
          "pnpm build:dsai",
          "tsup",
          "tsc --emitDeclarationOnly --outDir dist"
        ],
        "parallel": false
      }
    },
    "build:tokens": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "style-dictionary build --config sd.config.mjs"
      }
    },
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "dsai tokens validate"
      }
    },
    "sync": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "dsai tokens sync"
      }
    },
    "watch": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "style-dictionary build --config sd.config.mjs --watch"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "jestConfig": "packages/@dsai/tokens/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/@dsai/tokens/src/**/*.ts"]
      }
    }
  },
  "tags": ["type:library", "scope:tokens"]
}
