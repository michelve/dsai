{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsai.design/schemas/tokens.config.schema.json",
  "title": "DSAi Tokens Configuration",
  "description": "Configuration schema for DSAi design tokens build process. By default, all modes detected in collections or theme.json are built. Use ignoreModes to exclude specific modes.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "version": {
      "type": "string",
      "description": "Configuration version"
    },
    "description": {
      "type": "string",
      "description": "Configuration description"
    },
    "build": {
      "type": "object",
      "description": "Build source configuration. Automatic fallback: if preferred source not found, tries the other.",
      "properties": {
        "source": {
          "type": "string",
          "enum": ["collections", "theme"],
          "default": "theme",
          "description": "Preferred build source: 'theme' for combined theme.json (default), 'collections' for individual files. Falls back to other if not found."
        },
        "sourceOptions": {
          "type": "object",
          "properties": {
            "collections": {
              "type": "object",
              "properties": {
                "description": { "type": "string" },
                "path": { "type": "string" }
              }
            },
            "theme": {
              "type": "object",
              "properties": {
                "description": { "type": "string" },
                "path": { "type": "string" }
              }
            }
          }
        }
      },
      "required": ["source"]
    },
    "themes": {
      "type": "object",
      "description": "Theme mode configuration. All detected modes are built by default.",
      "properties": {
        "autoDetect": {
          "type": "boolean",
          "default": true,
          "description": "Auto-detect available modes from Figma export (default: true)"
        },
        "default": {
          "type": "string",
          "default": "Light",
          "description": "Default theme mode - uses :root selector"
        },
        "ignoreModes": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Modes to ignore/skip during build (e.g., ['WIP', 'Deprecated'])"
        },
        "selectorPattern": {
          "type": "object",
          "description": "CSS selector patterns for themes",
          "properties": {
            "default": {
              "type": "string",
              "default": ":root",
              "description": "Selector for default theme"
            },
            "others": {
              "type": "string",
              "default": "[data-dsai-theme=\"{mode}\"]",
              "description": "Selector pattern for other themes. {mode} is replaced with lowercase mode name."
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "description": "Output file configuration",
      "properties": {
        "css": {
          "type": "object",
          "properties": {
            "prefix": { "type": "string" },
            "outputReferences": { "type": "boolean" },
            "separateThemeFiles": { "type": "boolean" },
            "files": { "type": "object" }
          }
        },
        "scss": {
          "type": "object",
          "properties": {
            "files": { "type": "object" }
          }
        },
        "js": {
          "type": "object",
          "properties": {
            "files": { "type": "object" }
          }
        }
      }
    },
    "transform": {
      "type": "object",
      "description": "Transform configuration for Figma exports",
      "properties": {
        "preserveCodeSyntax": {
          "type": "boolean",
          "default": true,
          "description": "Preserve $codeSyntax from Figma exports"
        },
        "collections": {
          "type": "object",
          "description": "Collection-specific configuration",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Path to collection in theme.json (e.g., 'Foundation', 'Typography')"
              },
              "hasModes": {
                "type": "boolean",
                "default": false,
                "description": "Whether this collection has multiple modes (e.g., Light/Dark)"
              }
            },
            "required": ["path"]
          }
        }
      }
    }
  }
}
