{
  "name": "@dsai/tokens",
  "version": "0.0.1",
  "description": "Design tokens for DSAi component library - JavaScript/TypeScript exports only",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/ts/tokens.d.ts"
    },
    "./dist/js/tokens.js": "./dist/js/tokens.js",
    "./dist/ts/tokens.d.ts": "./dist/ts/tokens.d.ts",
    "./json": "./dist/json/tokens.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pnpm build:tokens",
    "build": "tsup",
    "build:tokens": "dsai tokens build",
    "build:watch": "tsup --watch",
    "dev": "dsai tokens build --watch & tsup --watch",
    "test": "echo 'Test tokens'",
    "validate": "dsai tokens validate",
    "validate:figma": "dsai tokens validate --figma",
    "validate:figma:master": "FIGMA_SOURCE=master dsai tokens validate --figma",
    "validate:figma:collections": "FIGMA_SOURCE=collections dsai tokens validate --figma",
    "validate:all": "dsai tokens validate --figma && dsai tokens validate",
    "transform": "dsai tokens transform",
    "sync": "dsai tokens sync",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "tokens",
    "dtcg",
    "w3c"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "dependencies": {
    "@dsai/tools": "workspace:*"
  },
  "devDependencies": {
    "style-dictionary": "^5.1.1"
  }
}
