{
  "name": "@dsai/tokens",
  "version": "0.0.1",
  "description": "Design tokens for DSAi component library",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./css": "./dist/css/variables.css",
    "./scss": "./dist/scss/_variables.scss"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pnpm build:tokens",
    "build": "tsup",
    "build:tokens": "pnpm tokens:validate && style-dictionary build --config sd.config.mjs",
    "build:watch": "tsup --watch",
    "dev": "pnpm tokens:watch & tsup --watch",
    "test": "echo 'Test tokens'",
    "tokens:validate": "node ../../../tools/scripts/validate-tokens.js",
    "tokens:transform": "node ../../../tools/scripts/transform-figma-tokens.js",
    "tokens:build": "pnpm tokens:transform && pnpm tokens:validate && style-dictionary build --config sd.config.mjs",
    "tokens:watch": "style-dictionary build --config sd.config.mjs --watch",
    "tokens:clean": "rm -rf dist"
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "tokens"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "style-dictionary": "^5.1.1"
  }
}
