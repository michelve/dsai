{
  "codeConnect": {
    "interactiveSetupFigmaFileUrl": "https://www.figma.com/design/abc123/my-design-system",
    "include": [
      "src/components/**/*.figma.tsx",
      "src/components/**/*.figma.ts",
      ".figma/**/*.figma.tsx",
      ".figma/**/*.figma.ts"
    ],
    "label": "@dsai/react",
    "parser": "react",
    "exclude": [
      "**/*.test.tsx",
      "**/*.test.ts",
      "**/*.spec.tsx",
      "**/*.spec.ts",
      "**/*.stories.tsx",
      "**/*.stories.ts",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/.storybook/**",
      "**/temp/**",
      "**/__tests__/**",
      "**/__mocks__/**",
      "**/e2e/**",
      "**/.turbo/**",
      "**/.next/**",
      "**/.cache/**"
    ],
    "importPaths": {
      "src/components/**/*": "@dsai/react",
      "src/compositions/**/*": "@dsai/react/compositions",
      "src/patterns/**/*": "@dsai/react/patterns",
      "src/hooks/**/*": "@dsai/react/hooks",
      "src/types/**/*": "@dsai/react/types",
      "src/utils/**/*": "@dsai/react/utils"
    },
    "paths": {
      "@dsai/react": ["src"],
      "@dsai/react/components": ["src/components"],
      "@dsai/react/compositions": ["src/compositions"],
      "@dsai/react/patterns": ["src/patterns"],
      "@dsai/react/hooks": ["src/hooks"],
      "@dsai/react/types": ["src/types"],
      "@dsai/react/utils": ["src/utils"]
    }
  },
  "documentUrlSubstitutions": {
    "<FIGMA_ICONS_BASE>": "https://figma.com/design/ZjZrrJoBgkA9qozUtAH1to",
    "<FIGMA_DSAI_TOOLTIP>": "https://figma.com/design/YOUR_DESIGN_FILE_ID?node-id=TOOLTIP_NODE_ID",
    "<FIGMA_DSAI_TOOLTIP_BUTTON>": "https://figma.com/design/YOUR_DESIGN_FILE_ID?node-id=TOOLTIP_BUTTON_NODE_ID",
    "<FIGMA_DSAI_TOOLTIP_ICON>": "https://figma.com/design/YOUR_DESIGN_FILE_ID?node-id=TOOLTIP_ICON_NODE_ID",
    "<FIGMA_DSAI_TOOLTIP_LINK>": "https://figma.com/design/YOUR_DESIGN_FILE_ID?node-id=TOOLTIP_LINK_NODE_ID"
  }
}
