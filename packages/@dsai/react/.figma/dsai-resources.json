{
  "$schema": "https://www.figma.com/developers/api/figma-make/resources-schema",
  "version": "1.0.0",
  "name": "DSAi Design System",
  "description": "Enterprise-grade React component library with Bootstrap 5 theming and WCAG 2.2 AA accessibility",
  "resources": [
    {
      "uri": "figma-make://dsai/design-system",
      "name": "DSAi Design System",
      "description": "Complete design system configuration for AI code generation",
      "metadata": {
        "framework": "react",
        "typescript": true,
        "styling": "bootstrap",
        "designSystem": "@dsai/react",
        "componentLibrary": {
          "name": "@dsai/react",
          "version": "0.0.1",
          "importPath": "@dsai/react",
          "components": [
            {
              "name": "Button",
              "import": "import { Button } from '@dsai/react';",
              "props": ["variant", "size", "type", "disabled", "fullWidth", "children"],
              "variants": [
                "primary",
                "secondary",
                "success",
                "danger",
                "warning",
                "info",
                "light",
                "dark",
                "outline-primary",
                "outline-secondary",
                "outline-success",
                "outline-danger",
                "outline-warning",
                "outline-info",
                "outline-light",
                "outline-dark",
                "link"
              ],
              "sizes": ["sm", "md", "lg"]
            }
          ]
        },
        "tokenSystem": {
          "name": "@dsai/tokens",
          "version": "0.0.1",
          "imports": {
            "css": "@dsai/tokens/css/bootstrap.css",
            "cssUtilities": "@dsai/tokens/css/dsai.css",
            "scss": "@dsai/tokens/src/scss/bootstrap-theme.scss"
          },
          "cssVariablePrefix": "--bs-",
          "collections": ["color", "typography", "spacing", "border", "shadow", "layout"]
        },
        "accessibility": {
          "standard": "WCAG 2.2 AA",
          "requirements": [
            "Color contrast ratio 4.5:1 for normal text",
            "Color contrast ratio 3:1 for large text",
            "Touch target size minimum 44x44px",
            "Visible focus indicators",
            "Semantic HTML elements",
            "ARIA attributes where needed"
          ],
          "testing": {
            "library": "jest-axe",
            "import": "import { axe, toHaveNoViolations } from 'jest-axe';"
          }
        },
        "testing": {
          "framework": "jest",
          "testingLibrary": "@testing-library/react",
          "userEvent": "@testing-library/user-event",
          "patterns": {
            "unit": "*.test.tsx",
            "integration": "*.integration.test.tsx"
          }
        },
        "codeStyle": {
          "formatting": "prettier",
          "linting": "eslint",
          "strictMode": true,
          "componentPattern": "forwardRef with displayName"
        }
      }
    },
    {
      "uri": "figma-make://dsai/button",
      "name": "Button Component",
      "description": "Accessible button component with Bootstrap 5 styling",
      "metadata": {
        "component": "Button",
        "import": "import { Button } from '@dsai/react';",
        "cssRequired": "@dsai/tokens/css/bootstrap.css",
        "props": {
          "variant": {
            "type": "ButtonVariant",
            "default": "primary",
            "options": [
              "primary",
              "secondary",
              "success",
              "danger",
              "warning",
              "info",
              "light",
              "dark",
              "outline-primary",
              "outline-secondary",
              "outline-success",
              "outline-danger",
              "outline-warning",
              "outline-info",
              "outline-light",
              "outline-dark",
              "link"
            ]
          },
          "size": {
            "type": "ButtonSize",
            "default": "md",
            "options": ["sm", "md", "lg"]
          },
          "type": {
            "type": "ButtonType",
            "default": "button",
            "options": ["button", "submit", "reset"]
          },
          "disabled": {
            "type": "boolean",
            "default": false
          },
          "fullWidth": {
            "type": "boolean",
            "default": false
          },
          "children": {
            "type": "ReactNode",
            "required": true
          }
        },
        "accessibility": {
          "role": "button",
          "ariaProps": [
            "aria-label",
            "aria-describedby",
            "aria-controls",
            "aria-expanded",
            "aria-pressed"
          ],
          "keyboardNav": ["Enter", "Space"]
        },
        "examples": [
          {
            "name": "Primary Button",
            "code": "<Button variant=\"primary\">Click me</Button>"
          },
          {
            "name": "Outline Button",
            "code": "<Button variant=\"outline-secondary\" size=\"lg\">Large Outline</Button>"
          },
          {
            "name": "Full Width Button",
            "code": "<Button variant=\"success\" fullWidth>Full Width</Button>"
          },
          {
            "name": "Disabled Button",
            "code": "<Button variant=\"primary\" disabled>Disabled</Button>"
          },
          {
            "name": "Submit Button",
            "code": "<Button variant=\"primary\" type=\"submit\">Submit Form</Button>"
          }
        ]
      }
    }
  ]
}
