{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "@dsai/react",
  "sourceRoot": "packages/@dsai/react/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "outputPath": "packages/@dsai/react/dist",
        "main": "packages/@dsai/react/src/index.ts",
        "tsConfig": "packages/@dsai/react/tsconfig.json",
        "assets": []
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "jestConfig": "packages/@dsai/react/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/@dsai/react/**/*.{ts,tsx}"]
      }
    }
  },
  "tags": ["type:library", "scope:react"]
}
