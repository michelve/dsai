{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "@dsai/storybook",
  "sourceRoot": "packages/@dsai/storybook/.storybook",
  "projectType": "application",

  "targets": {
    // ========= STORYBOOK SERVE =========
    "storybook": {
      "executor": "@nx/storybook:storybook",
      "options": {
        "port": 6006,
        "configDir": "packages/@dsai/storybook/.storybook"
      }
    },

    // ========= STORYBOOK BUILD =========
    "build-storybook": {
      "executor": "@nx/storybook:build",
      "outputs": ["{projectRoot}/storybook-static"],
      "options": {
        "configDir": "packages/@dsai/storybook/.storybook",
        "outputDir": "packages/@dsai/storybook/storybook-static"
      }
    },

    // ========= TEST =========
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "jestConfig": "packages/@dsai/storybook/jest.config.ts",
        "passWithNoTests": true
      }
    },

    // ========= STOP / CLEANUP =========
    "kill": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash tools/scripts/storybook/kill-storybook.sh"
      }
    },

    "stop": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash tools/scripts/storybook/kill-storybook.sh"
      }
    }
  },

  "tags": ["type:application", "scope:storybook"]
}
