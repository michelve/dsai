{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./.storybook/dist",
    "jsx": "react-jsx",
    "moduleResolution": "bundler"
  },
  "include": [".storybook/**/*", "../react/src/**/*", "../tokens/src/**/*"],
