{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./.storybook/dist",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@dsai/tokens": ["../@dsai/tokens/src"],
      "@dsai/tokens/css/*": ["../@dsai/tokens/dist/css/*"],
      "@dsai/tokens/js/*": ["../@dsai/tokens/dist/js/*"]
    }
  },
  "include": [".storybook/**/*", "docs/**/*", "../react/src/**/*", "../tokens/src/**/*"],
  "exclude": ["node_modules", "storybook-static"],
  "references": [
    {
      "path": "../react/tsconfig.json"
    },
    {
      "path": "../tokens/tsconfig.json"
    }
  ]
}
