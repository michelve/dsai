{
  "name": "@dsai/storybook",
  "version": "1.0.1",
  "description": "Storybook configuration and documentation for DSAi components",
  "private": true,
  "scripts": {
    "prestorybook": "pnpm --filter @dsai/tokens build",
    "storybook": "STORYBOOK_EDITOR_URL='vscode://file/{{path}}:{{line}}:{{column}}' storybook dev -p 6006",
    "kill": "bash ../../tools/scripts/storybook/kill-storybook.sh",
    "stop": "pnpm kill",
    "prebuild": "pnpm --filter @dsai/tokens build",
    "build": "storybook build -o ./storybook-static",
    "build-storybook": "pnpm build",
    "verify": "bash ../../tools/scripts/storybook/verify-storybook.sh",
    "test": "test-storybook",
    "test-storybook": "test-storybook",
    "chromatic": "npx chromatic --project-token=chpt_d2e59f6da7c3b1c"
  },
  "keywords": [
    "storybook",
    "documentation",
    "design-system"
  ],
  "dependencies": {
    "@dsai/react": "workspace:*",
    "@dsai/tokens": "workspace:*"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@storybook/addon-a11y": "^10.1.2",
    "@storybook/addon-designs": "^11.0.3",
    "@storybook/addon-docs": "10.1.2",
    "@storybook/addon-links": "^10.1.2",
    "@storybook/react": "^10.1.2",
    "@storybook/react-vite": "^10.1.2",
    "chromatic": "^13.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.2.6"
  }
}
