{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "@dsai-io/icons",
  "sourceRoot": "packages/@dsai-io/icons/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "packages/@dsai-io/icons",
        "command": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/@dsai-io/icons",
        "command": "tsup --watch"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/@dsai-io/icons/src/**/*.{ts,tsx}", "!packages/@dsai-io/icons/src/**/*.d.ts"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/@dsai-io/icons",
        "command": "tsc --noEmit"
      }
    }
  },
  "tags": ["type:library", "scope:icons"]
}
