{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./.storybook/dist",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [".storybook/**/*", "docs/**/*", "src/**/*", "../react/src/**/*"],
  "exclude": ["node_modules", "storybook-static"],
  "references": [
    {
      "path": "../react/tsconfig.json"
    }
  ]
}
