{
  "name": "@dsai-io/storybook",
  "version": "1.0.6",
  "description": "Storybook configuration and documentation for DSAi components",
  "scripts": {
    "tokens:transform": "node ../tools/bin/dsai-tools.mjs tokens transform",
    "tokens:sd": "style-dictionary build --config sd.config.mjs",
    "tokens:sd:dark": "style-dictionary build --config sd.config.dark.mjs",
    "tokens:build": "node ../tools/bin/dsai-tools.mjs tokens validate && pnpm tokens:transform && pnpm tokens:sd && pnpm tokens:sd:dark",
    "scss:build": "sass --load-path=node_modules src/scss/dsai-theme-bs.scss src/generated/dsai-theme-bs.css",
    "styles:all": "pnpm tokens:build && pnpm scss:build",
    "prestorybook": "pnpm styles:all",
    "storybook": "STORYBOOK_EDITOR_URL='vscode://file/{{path}}:{{line}}:{{column}}' storybook dev -p 6006",
    "kill": "bash ../../tools/scripts/storybook/kill-storybook.sh",
    "stop": "pnpm kill",
    "prebuild": "pnpm styles:all",
    "build": "storybook build -o ./storybook-static",
    "build-storybook": "pnpm build",
    "verify": "bash ../../tools/scripts/storybook/verify-storybook.sh",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test-storybook": "test-storybook",
    "chromatic": "npx chromatic --project-token=chpt_d2e59f6da7c3b1c"
  },
  "keywords": [
    "storybook",
    "documentation",
    "design-system"
  ],
  "dependencies": {
    "@dsai-io/figma-tokens": "workspace:*",
    "@dsai-io/react": "workspace:*",
    "@dsai-io/tools": "workspace:*",
    "bootstrap": "^5.3.8",
    "glob": "^11.0.2",
    "sass": "^1.94.2",
    "style-dictionary": "^5.1.1"
  },
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-designs": "^11.1.1",
    "@storybook/addon-docs": "10.1.11",
    "@storybook/addon-links": "^10.1.11",
    "@storybook/addon-vitest": "10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/browser-playwright": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.15",
    "chromatic": "^13.3.4",
    "lightningcss": "^1.30.1",
    "playwright": "^1.57.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.1.11",
    "vite": "^7.2.6",
    "vitest": "^4.0.15"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
