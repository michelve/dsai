{
  "name": "@dsai-io/react",
  "version": "1.0.2",
  "description": "DSAi React - Accessible, themeable React components with WCAG 2.1 AA compliance, design tokens, and TypeScript support",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./compositions": {
      "types": "./dist/compositions/index.d.ts",
      "import": "./dist/compositions/index.mjs",
      "require": "./dist/compositions/index.js"
    },
    "./compositions/*": {
      "types": "./dist/compositions/*.d.ts",
      "import": "./dist/compositions/*.mjs",
      "require": "./dist/compositions/*.js"
    },
    "./patterns": {
      "types": "./dist/patterns/index.d.ts",
      "import": "./dist/patterns/index.mjs",
      "require": "./dist/patterns/index.js"
    },
    "./patterns/*": {
      "types": "./dist/patterns/*.d.ts",
      "import": "./dist/patterns/*.mjs",
      "require": "./dist/patterns/*.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.mjs",
      "require": "./dist/hooks/index.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.mjs",
      "require": "./dist/hooks/*.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.js"
    },
    "./styles": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsup --watch",
    "test": "echo 'Test components'",
    "lint": "echo 'Lint components'",
    "icons:generate": "dsai icons build --format react",
    "icons:figma": "node ../../tools/scripts/icons/generate-figma-code-connect.cjs",
    "figma:connect": "figma connect",
    "figma:validate": "figma connect validate",
    "figma:publish": "figma connect publish",
    "figma:publish:dry": "figma connect publish --dry-run"
  },
  "keywords": [
    "react",
    "react-components",
    "design-system",
    "ui-library",
    "component-library",
    "dsai",
    "typescript",
    "accessible",
    "a11y",
    "wcag",
    "design-tokens",
    "theming",
    "ui-kit"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16"
  },
  "devDependencies": {
    "@dsai-io/tools": "workspace:^",
    "@figma/code-connect": "^1.4.2"
  },
  "license": "AGPL-3.0-or-later",
  "publishConfig": {
    "access": "restricted"
  }
}
