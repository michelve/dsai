{
  "name": "@dsai-io/figma-tokens",
  "version": "1.0.4",
  "description": "Figma integration utilities and token synchronization for DSAi",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dsai-figma": "./bin/dsai-figma.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsup --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "figma",
    "design-tokens",
    "figma-api",
    "code-connect",
    "style-dictionary",
    "dtcg"
  ],
  "dependencies": {
    "@dsai-io/tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.1"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "AGPL-3.0-or-later",
  "publishConfig": {
    "access": "restricted"
  }
}
