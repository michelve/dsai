{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json",
  "default": true,

  "MD001": true,
  "MD003": {
    "style": "atx"
  },
  "MD004": {
    "style": "dash"
  },
  "MD005": true,
  "MD007": {
    "indent": 2,
    "start_indented": false
  },
  "MD009": {
    "br_spaces": 2,
    "list_item_empty_lines": false,
    "strict": true
  },
  "MD010": {
    "code_blocks": false,
    "spaces_per_tab": 2
  },
  "MD011": true,
  "MD012": {
    "maximum": 1
  },
  "MD013": false,
  "MD014": true,
  "MD018": true,
  "MD019": true,
  "MD020": true,
  "MD021": true,
  "MD022": {
    "lines_above": 1,
    "lines_below": 1
  },
  "MD023": true,
  "MD024": {
    "siblings_only": true
  },
  "MD025": {
    "front_matter_title": "^\\s*title\\s*[:=]",
    "level": 1
  },
  "MD026": {
    "punctuation": ".,;:!?"
  },
  "MD027": true,
  "MD028": true,
  "MD029": {
    "style": "one_or_ordered"
  },
  "MD030": {
    "ul_single": 1,
    "ol_single": 1,
    "ul_multi": 1,
    "ol_multi": 1
  },
  "MD031": {
    "list_items": true
  },
  "MD032": true,
  "MD033": {
    "allowed_elements": [
      "a",
      "br",
      "details",
      "summary",
      "img",
      "kbd",
      "sub",
      "sup",
      "picture",
      "source",
      "video",
      "audio",
      "figure",
      "figcaption",
      "abbr",
      "cite",
      "dfn",
      "mark",
      "small",
      "time",
      "wbr"
    ]
  },
  "MD034": true,
  "MD035": {
    "style": "---"
  },
  "MD036": false,
  "MD037": true,
  "MD038": true,
  "MD039": true,
  "MD040": true,
  "MD041": true,
  "MD042": true,
  "MD044": {
    "names": ["DSAi", "GitHub", "JavaScript", "TypeScript", "Node.js", "npm", "pnpm"],
    "code_blocks": false,
    "html_elements": false
  },
  "MD045": true,
  "MD046": {
    "style": "fenced"
  },
  "MD047": true,
  "MD048": {
    "style": "backtick"
  },
  "MD049": {
    "style": "asterisk"
  },
  "MD050": {
    "style": "asterisk"
  },
  "MD051": true,
  "MD052": true,
  "MD053": true,
  "MD054": {
    "autolink": true,
    "inline": true,
    "full": true,
    "collapsed": true,
    "shortcut": true,
    "url_inline": true
  },
  "MD055": {
    "style": "leading_and_trailing"
  },
  "MD056": true,
  "MD058": true
}
