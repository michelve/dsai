[
  {
    "Components | Breadcrumb": {
      "modes": {
        "Light Mode": {
          "breadcrumb": {
            "background": { "$scopes": ["ALL_FILLS"], "$type": "color", "$value": "transparent" },
            "text": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{colors.neutral.gray.700}"
            },
            "active": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{colors.neutral.gray.500}"
            },
            "divider": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{colors.neutral.gray.500}"
            }
          }
        },
        "Dark Mode": {
          "breadcrumb": {
            "$value": "{breadcrumb}",
            "$type": "COMPOSITE",
            "text": { "$type": "color", "$value": "{colors.neutral.gray.200}" },
            "active": { "$type": "color", "$value": "{colors.neutral.gray.500}" },
            "divider": { "$type": "color", "$value": "{colors.neutral.gray.500}" }
          }
        }
      }
    }
  }
]
