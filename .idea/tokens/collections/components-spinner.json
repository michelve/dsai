[
  {
    "Components | Spinner": {
      "modes": {
        "Light Mode": {
          "spinner": {
            "border-color": {
              "$scopes": ["STROKE_COLOR"],
              "$type": "color",
              "$value": "rgba(0,0,0,.1)"
            },
            "border-top-color": {
              "$scopes": ["STROKE_COLOR"],
              "$type": "color",
              "$value": "{colors.theme.primary}"
            }
          }
        },
        "Dark Mode": {
          "spinner": {
            "$value": "{spinner}",
            "$type": "COMPOSITE",
            "border-color": { "$type": "color", "$value": "rgba(255,255,255,.1)" }
          }
        }
      }
    }
  }
]
