[
  {
    "Components | Range": {
      "modes": {
        "Light Mode": {
          "range": {
            "track-bg": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "{colors.neutral.gray.300}"
            },
            "thumb-bg": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "{colors.theme.primary}"
            },
            "thumb-shadow": {
              "$scopes": ["EFFECT_FLOAT"],
              "$type": "string",
              "$value": "0 .1rem .25rem rgba(0,0,0,.1)"
            }
          }
        },
        "Dark Mode": {
          "range": {
            "$value": "{range}",
            "$type": "COMPOSITE",
            "track-bg": { "$type": "color", "$value": "{colors.neutral.gray.600}" },
            "thumb-shadow": { "$type": "string", "$value": "0 .1rem .25rem rgba(255,255,255,.1)" }
          }
        }
      }
    }
  }
]
