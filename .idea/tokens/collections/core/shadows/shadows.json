{
  "Shadows": {
    "modes": {
      "Base": {
        "shadows": {
          "default": {
            "composite": {
              "$value": "0 0.5rem 1rem rgba(0, 0, 0, 0.15)",
              "$type": "string",
              "$description": "Complete box shadow value for Bootstrap SCSS export",
              "$scopes": ["ALL_SCOPES"],
              "$extensions": {
                "docs.reference": "https://getbootstrap.com/docs/5.3/utilities/shadows/",
                "platform.cssClass": "shadow",
                "platform.scssVariableName": "$box-shadow"
              }
            },
            "color": {
              "$value": "rgba(0, 0, 0, 0.15)",
              "$type": "color",
              "$description": "Shadow color for default elevation",
              "$scopes": ["EFFECT_COLOR"]
            },
            "offsetX": {
              "$value": 0,
              "$type": "number",
              "$description": "Shadow horizontal offset",
              "$scopes": ["ALL_SCOPES"]
            },
            "offsetY": {
              "$value": 8,
              "$type": "number",
              "$description": "Shadow vertical offset (0.5rem = 8px)",
              "$scopes": ["ALL_SCOPES"]
            },
            "blur": {
              "$value": 16,
              "$type": "number",
              "$description": "Shadow blur radius (1rem = 16px)",
              "$scopes": ["ALL_SCOPES"]
            },
            "spread": {
              "$value": 0,
              "$type": "number",
              "$description": "Shadow spread radius",
              "$scopes": ["ALL_SCOPES"]
            }
          },
          "sm": {
            "composite": {
              "$value": "0 0.125rem 0.25rem rgba(0, 0, 0, 0.075)",
              "$type": "string",
              "$description": "Complete box shadow value for Bootstrap SCSS export",
              "$scopes": ["ALL_SCOPES"],
              "$extensions": {
                "docs.reference": "https://getbootstrap.com/docs/5.3/utilities/shadows/",
                "platform.cssClass": "shadow-sm",
                "platform.scssVariableName": "$box-shadow-sm"
              }
            },
            "color": {
              "$value": "rgba(0, 0, 0, 0.075)",
              "$type": "color",
              "$description": "Shadow color for small elevation",
              "$scopes": ["EFFECT_COLOR"]
            },
            "offsetX": {
              "$value": 0,
              "$type": "number",
              "$description": "Shadow horizontal offset",
              "$scopes": ["ALL_SCOPES"]
            },
            "offsetY": {
              "$value": 2,
              "$type": "number",
              "$description": "Shadow vertical offset (0.125rem = 2px)",
              "$scopes": ["ALL_SCOPES"]
            },
            "blur": {
              "$value": 4,
              "$type": "number",
              "$description": "Shadow blur radius (0.25rem = 4px)",
              "$scopes": ["ALL_SCOPES"]
            },
            "spread": {
              "$value": 0,
              "$type": "number",
              "$description": "Shadow spread radius",
              "$scopes": ["ALL_SCOPES"]
            }
          },
          "lg": {
            "composite": {
              "$value": "0 1rem 3rem rgba(0, 0, 0, 0.175)",
              "$type": "string",
              "$description": "Complete box shadow value for Bootstrap SCSS export",
              "$scopes": ["ALL_SCOPES"],
              "$extensions": {
                "docs.reference": "https://getbootstrap.com/docs/5.3/utilities/shadows/",
                "platform.cssClass": "shadow-lg",
                "platform.scssVariableName": "$box-shadow-lg"
              }
            },
            "color": {
              "$value": "rgba(0, 0, 0, 0.175)",
              "$type": "color",
              "$description": "Shadow color for large elevation",
              "$scopes": ["EFFECT_COLOR"]
            },
            "offsetX": {
              "$value": 0,
              "$type": "number",
              "$description": "Shadow horizontal offset",
              "$scopes": ["ALL_SCOPES"]
            },
            "offsetY": {
              "$value": 16,
              "$type": "number",
              "$description": "Shadow vertical offset (1rem = 16px)",
              "$scopes": ["ALL_SCOPES"]
            },
            "blur": {
              "$value": 48,
              "$type": "number",
              "$description": "Shadow blur radius (3rem = 48px)",
              "$scopes": ["ALL_SCOPES"]
            },
            "spread": {
              "$value": 0,
              "$type": "number",
              "$description": "Shadow spread radius",
              "$scopes": ["ALL_SCOPES"]
            }
          },
          "inset": {
            "composite": {
              "$value": "inset 0 1px 2px rgba(0, 0, 0, 0.075)",
              "$type": "string",
              "$description": "Complete box shadow value for Bootstrap SCSS export",
              "$scopes": ["ALL_SCOPES"],
              "$extensions": {
                "docs.reference": "https://getbootstrap.com/docs/5.3/utilities/shadows/",
                "platform.scssVariableName": "$box-shadow-inset"
              }
            },
            "color": {
              "$value": "rgba(0, 0, 0, 0.075)",
              "$type": "color",
              "$description": "Shadow color for inset effect",
              "$scopes": ["EFFECT_COLOR"]
            },
            "offsetX": {
              "$value": 0,
              "$type": "number",
              "$description": "Shadow horizontal offset",
              "$scopes": ["ALL_SCOPES"]
            },
            "offsetY": {
              "$value": 1,
              "$type": "number",
              "$description": "Shadow vertical offset (1px)",
              "$scopes": ["ALL_SCOPES"]
            },
            "blur": {
              "$value": 2,
              "$type": "number",
              "$description": "Shadow blur radius (2px)",
              "$scopes": ["ALL_SCOPES"]
            },
            "spread": {
              "$value": 0,
              "$type": "number",
              "$description": "Shadow spread radius",
              "$scopes": ["ALL_SCOPES"]
            }
          }
        }
      }
    }
  }
}
