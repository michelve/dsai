[
  {
    "Components | Alert": {
      "modes": {
        "Light Mode": {
          "alert": {
            "success": {
              "background": {
                "$scopes": ["ALL_FILLS"],
                "$type": "color",
                "$value": "{colors.theme.success}"
              },
              "text": {
                "$scopes": ["TEXT_FILL"],
                "$type": "color",
                "$value": "{colors.neutral.white}"
              },
              "border": {
                "$scopes": ["STROKE_COLOR"],
                "$type": "color",
                "$value": "{colors.theme.success}"
              }
            },
            "warning": {
              "background": {
                "$scopes": ["ALL_FILLS"],
                "$type": "color",
                "$value": "{colors.theme.warning}"
              },
              "text": {
                "$scopes": ["TEXT_FILL"],
                "$type": "color",
                "$value": "{colors.neutral.black}"
              },
              "border": {
                "$scopes": ["STROKE_COLOR"],
                "$type": "color",
                "$value": "{colors.theme.warning}"
              }
            },
            "danger": {
              "background": {
                "$scopes": ["ALL_FILLS"],
                "$type": "color",
                "$value": "{colors.theme.danger}"
              },
              "text": {
                "$scopes": ["TEXT_FILL"],
                "$type": "color",
                "$value": "{colors.neutral.white}"
              },
              "border": {
                "$scopes": ["STROKE_COLOR"],
                "$type": "color",
                "$value": "{colors.theme.danger}"
              }
            },
            "info": {
              "background": {
                "$scopes": ["ALL_FILLS"],
                "$type": "color",
                "$value": "{colors.theme.info}"
              },
              "text": {
                "$scopes": ["TEXT_FILL"],
                "$type": "color",
                "$value": "{colors.neutral.black}"
              },
              "border": {
                "$scopes": ["STROKE_COLOR"],
                "$type": "color",
                "$value": "{colors.theme.info}"
              }
            }
          }
        },
        "Dark Mode": {
          "alert": {
            "$value": "{alert}",
            "$type": "COMPOSITE",
            "success": {
              "text": {
                "$scopes": ["TEXT_FILL"],
                "$type": "color",
                "$value": "{colors.neutral.white}"
              }
            },
            "warning": {
              "text": {
                "$scopes": ["TEXT_FILL"],
                "$type": "color",
                "$value": "{colors.neutral.black}"
              }
            },
            "danger": {
              "text": {
                "$scopes": ["TEXT_FILL"],
                "$type": "color",
                "$value": "{colors.neutral.white}"
              }
            },
            "info": {
              "text": {
                "$scopes": ["TEXT_FILL"],
                "$type": "color",
                "$value": "{colors.neutral.black}"
              }
            }
          }
        }
      }
    }
  }
]
