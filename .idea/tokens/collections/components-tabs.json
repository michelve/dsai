[
  {
    "Components | Tabs": {
      "modes": {
        "Light Mode": {
          "tabs": {
            "link-color": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{semantic.text.link}"
            },
            "link-hover-color": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{colors.brand.blue.scale.600}"
            },
            "link-active-color": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{colors.neutral.gray.700}"
            },
            "link-active-bg": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "{colors.neutral.white}"
            },
            "link-active-border": {
              "$scopes": ["STROKE_COLOR"],
              "$type": "color",
              "$value": "{colors.neutral.gray.300}"
            },
            "nav-border": {
              "$scopes": ["STROKE_COLOR"],
              "$type": "color",
              "$value": "{colors.neutral.gray.300}"
            },
            "radius": { "$scopes": ["CORNER_RADIUS"], "$type": "float", "$value": 6 }
          }
        },
        "Dark Mode": {
          "tabs": {
            "$value": "{tabs}",
            "$type": "COMPOSITE",
            "link-hover-color": { "$type": "color", "$value": "{colors.brand.blue.scale.300}" },
            "link-active-color": { "$type": "color", "$value": "{colors.neutral.gray.200}" },
            "link-active-bg": { "$type": "color", "$value": "{semantic.background.body}" },
            "link-active-border": { "$type": "color", "$value": "{semantic.border.default}" },
            "nav-border": { "$type": "color", "$value": "{semantic.border.default}" }
          }
        }
      }
    }
  }
]
