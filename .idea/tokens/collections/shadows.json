[
  {
    "Shadows": {
      "modes": {
        "Light Mode": {
          "shadows": {
            "default": {
              "$scopes": ["EFFECT_FLOAT"],
              "$type": "string",
              "$value": "0 0.5rem 1rem rgba(0, 0, 0, 0.15)"
            },
            "sm": {
              "$scopes": ["EFFECT_FLOAT"],
              "$type": "string",
              "$value": "0 0.125rem 0.25rem rgba(0, 0, 0, 0.075)"
            },
            "lg": {
              "$scopes": ["EFFECT_FLOAT"],
              "$type": "string",
              "$value": "0 1rem 3rem rgba(0, 0, 0, 0.175)"
            },
            "inset": {
              "$scopes": ["EFFECT_FLOAT"],
              "$type": "string",
              "$value": "inset 0 1px 2px rgba(0, 0, 0, 0.075)"
            }
          }
        },
        "Dark Mode": {
          "shadows": { "$value": "{shadows}", "$type": "COMPOSITE" }
        }
      }
    }
  }
]
