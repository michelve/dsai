[
  {
    "Components | Validation": {
      "modes": {
        "Light Mode": {
          "validation": {
            "valid-color": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{colors.theme.success}"
            },
            "invalid-color": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{colors.theme.danger}"
            }
          }
        },
        "Dark Mode": {
          "validation": { "$value": "{validation}", "$type": "COMPOSITE" }
        }
      }
    }
  }
]
