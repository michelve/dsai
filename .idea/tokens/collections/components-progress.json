[
  {
    "Components | Progress": {
      "modes": {
        "Light Mode": {
          "progress": {
            "track-bg": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "{colors.neutral.gray.100}"
            },
            "bar-bg": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "{colors.theme.primary}"
            },
            "bar-color": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{colors.neutral.white}"
            },
            "height": { "$scopes": ["WIDTH_HEIGHT"], "$type": "float", "$value": 16 }
          }
        },
        "Dark Mode": {
          "progress": {
            "$value": "{progress}",
            "$type": "COMPOSITE",
            "track-bg": { "$type": "color", "$value": "{semantic.background.subtle}" }
          }
        }
      }
    }
  }
]
