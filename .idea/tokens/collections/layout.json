[
  {
    "Layout": {
      "modes": {
        "Light Mode": {
          "layout": {
            "breakpoints": {
              "xs": { "$scopes": ["WIDTH_HEIGHT"], "$type": "float", "$value": 0 },
              "sm": { "$scopes": ["WIDTH_HEIGHT"], "$type": "float", "$value": 576 },
              "md": { "$scopes": ["WIDTH_HEIGHT"], "$type": "float", "$value": 768 },
              "lg": { "$scopes": ["WIDTH_HEIGHT"], "$type": "float", "$value": 992 },
              "xl": { "$scopes": ["WIDTH_HEIGHT"], "$type": "float", "$value": 1200 },
              "xxl": { "$scopes": ["WIDTH_HEIGHT"], "$type": "float", "$value": 1400 }
            },
            "container-max-width": {
              "sm": { "$scopes": ["WIDTH_HEIGHT"], "$type": "float", "$value": 540 },
              "md": { "$scopes": ["WIDTH_HEIGHT"], "$type": "float", "$value": 720 },
              "lg": { "$scopes": ["WIDTH_HEIGHT"], "$type": "float", "$value": 960 },
              "xl": { "$scopes": ["WIDTH_HEIGHT"], "$type": "float", "$value": 1140 },
              "xxl": { "$scopes": ["WIDTH_HEIGHT"], "$type": "float", "$value": 1320 }
            },
            "grid": {
              "columns": { "$scopes": ["ALL_SCOPES"], "$type": "float", "$value": 12 },
              "gutter": { "$scopes": ["GAP"], "$type": "float", "$value": 24 }
            }
          }
        },
        "Dark Mode": {
          "layout": { "$value": "{layout}", "$type": "COMPOSITE" }
        }
      }
    }
  }
]
