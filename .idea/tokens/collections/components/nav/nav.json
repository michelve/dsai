[
  {
    "Components | Nav": {
      "modes": {
        "Light": {
          "nav": {
            "link-color": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{semantic.text.link}"
            },
            "link-hover-color": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{colors.brand.blue.scale.600}"
            },
            "link-active-color": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{colors.neutral.gray.700}"
            },
            "link-disabled-color": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{colors.neutral.gray.600}"
            }
          }
        },
        "Dark": {
          "nav": {
            "$value": "{nav}",
            "$type": "COMPOSITE",
            "link-hover-color": { "$type": "color", "$value": "{colors.brand.blue.scale.300}" },
            "link-active-color": { "$type": "color", "$value": "{colors.neutral.gray.200}" },
            "link-disabled-color": { "$type": "color", "$value": "{colors.neutral.gray.500}" }
          }
        }
      }
    }
  }
]
