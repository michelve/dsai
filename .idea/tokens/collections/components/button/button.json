[
  {
    "Components | Button": {
      "modes": {
        "Light": {
          "button": {
            "primary": {
              "background": {
                "$scopes": ["ALL_FILLS"],
                "$type": "color",
                "$value": "{colors.theme.primary}",
                "$description": "Button primary background"
              },
              "text": {
                "$scopes": ["TEXT_FILL"],
                "$type": "color",
                "$value": "{colors.neutral.white}",
                "$description": "Button primary text color"
              },
              "border": {
                "$scopes": ["STROKE_COLOR"],
                "$type": "color",
                "$value": "{colors.theme.primary}",
                "$description": "Button primary border color"
              },
              "radius": {
                "$scopes": ["CORNER_RADIUS"],
                "$type": "float",
                "$value": 6,
                "$description": "Button corner radius"
              },
              "padding-x": {
                "$scopes": ["GAP"],
                "$type": "float",
                "$value": 12,
                "$description": "Button horizontal padding"
              },
              "padding-y": {
                "$scopes": ["GAP"],
                "$type": "float",
                "$value": 6,
                "$description": "Button vertical padding"
              }
            },
            "secondary": {
              "background": {
                "$scopes": ["ALL_FILLS"],
                "$type": "color",
                "$value": "{colors.theme.secondary}",
                "$description": "Button secondary background"
              },
              "text": {
                "$scopes": ["TEXT_FILL"],
                "$type": "color",
                "$value": "{colors.neutral.white}",
                "$description": "Button secondary text color"
              },
              "border": {
                "$scopes": ["STROKE_COLOR"],
                "$type": "color",
                "$value": "{colors.theme.secondary}",
                "$description": "Button secondary border color"
              }
            },
            "danger": {
              "background": {
                "$scopes": ["ALL_FILLS"],
                "$type": "color",
                "$value": "{colors.theme.danger}",
                "$description": "Button danger background"
              },
              "text": {
                "$scopes": ["TEXT_FILL"],
                "$type": "color",
                "$value": "{colors.neutral.white}",
                "$description": "Button danger text color"
              },
              "border": {
                "$scopes": ["STROKE_COLOR"],
                "$type": "color",
                "$value": "{colors.theme.danger}",
                "$description": "Button danger border color"
              }
            },
            "success": {
              "background": {
                "$scopes": ["ALL_FILLS"],
                "$type": "color",
                "$value": "{colors.theme.success}",
                "$description": "Button success background"
              },
              "text": {
                "$scopes": ["TEXT_FILL"],
                "$type": "color",
                "$value": "{colors.neutral.white}",
                "$description": "Button success text color"
              },
              "border": {
                "$scopes": ["STROKE_COLOR"],
                "$type": "color",
                "$value": "{colors.theme.success}",
                "$description": "Button success border color"
              }
            }
          }
        },
        "Dark": {
          "button": {
            "$value": "{button}",
            "$type": "COMPOSITE",
            "primary": {
              "text": {
                "$scopes": ["TEXT_FILL"],
                "$type": "color",
                "$value": "{colors.neutral.white}"
              }
            },
            "secondary": {
              "text": {
                "$scopes": ["TEXT_FILL"],
                "$type": "color",
                "$value": "{colors.neutral.white}"
              }
            },
            "danger": {
              "text": {
                "$scopes": ["TEXT_FILL"],
                "$type": "color",
                "$value": "{colors.neutral.white}"
              }
            },
            "success": {
              "text": {
                "$scopes": ["TEXT_FILL"],
                "$type": "color",
                "$value": "{colors.neutral.white}"
              }
            }
          }
        }
      }
    }
  }
]
