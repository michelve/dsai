[
  {
    "Components | Close": {
      "modes": {
        "Light": {
          "close": {
            "color": { "$scopes": ["TEXT_FILL"], "$type": "color", "$value": "rgba(0,0,0,.5)" },
            "hover-color": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "rgba(0,0,0,.75)"
            }
          }
        },
        "Dark": {
          "close": {
            "$value": "{close}",
            "$type": "COMPOSITE",
            "color": { "$type": "color", "$value": "rgba(255,255,255,.5)" },
            "hover-color": { "$type": "color", "$value": "rgba(255,255,255,.75)" }
          }
        }
      }
    }
  }
]
