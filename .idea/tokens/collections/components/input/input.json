[
  {
    "Components | Input": {
      "modes": {
        "Light": {
          "input": {
            "background": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "{colors.neutral.white}",
              "$description": "Input background"
            },
            "text": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{semantic.text.body}",
              "$description": "Input text color"
            },
            "placeholder": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{semantic.text.muted}",
              "$description": "Input placeholder color"
            },
            "border": {
              "$scopes": ["STROKE_COLOR"],
              "$type": "color",
              "$value": "{colors.neutral.gray.400}",
              "$description": "Input border color"
            },
            "focus-border": {
              "$scopes": ["STROKE_COLOR"],
              "$type": "color",
              "$value": "{colors.theme.primary}",
              "$description": "Input focus border color"
            },
            "focus-ring": {
              "$scopes": ["EFFECT_COLOR"],
              "$type": "color",
              "$value": "rgba(13, 110, 253, 0.25)",
              "$description": "Input focus ring color"
            },
            "radius": {
              "$scopes": ["CORNER_RADIUS"],
              "$type": "float",
              "$value": 6,
              "$description": "Input corner radius"
            },
            "padding-x": {
              "$scopes": ["GAP"],
              "$type": "float",
              "$value": 12,
              "$description": "Input horizontal padding"
            },
            "padding-y": {
              "$scopes": ["GAP"],
              "$type": "float",
              "$value": 6,
              "$description": "Input vertical padding"
            }
          }
        },
        "Dark": {
          "input": {
            "$value": "{input}",
            "$type": "COMPOSITE",
            "background": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "{semantic.background.subtle}"
            },
            "text": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{semantic.text.body}"
            },
            "placeholder": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{semantic.text.muted}"
            },
            "border": {
              "$scopes": ["STROKE_COLOR"],
              "$type": "color",
              "$value": "{semantic.border.default}"
            },
            "focus-border": {
              "$scopes": ["STROKE_COLOR"],
              "$type": "color",
              "$value": "{colors.brand.blue.scale.300}"
            },
            "focus-ring": {
              "$scopes": ["EFFECT_COLOR"],
              "$type": "color",
              "$value": "rgba(110, 168, 254, 0.25)"
            }
          }
        }
      }
    }
  }
]
