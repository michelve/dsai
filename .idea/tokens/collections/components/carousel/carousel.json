[
  {
    "Components | Carousel": {
      "modes": {
        "Light": {
          "carousel": {
            "control-color": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{colors.neutral.white}"
            },
            "control-bg": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "rgba(0,0,0,.5)"
            },
            "indicator-active-bg": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "{colors.neutral.white}"
            },
            "caption-color": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{colors.neutral.white}"
            }
          }
        },
        "Dark": {
          "carousel": { "$value": "{carousel}", "$type": "COMPOSITE" }
        }
      }
    }
  }
]
