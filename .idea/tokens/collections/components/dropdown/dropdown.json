[
  {
    "Components | Dropdown": {
      "modes": {
        "Light": {
          "dropdown": {
            "background": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "{colors.neutral.white}"
            },
            "text": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{semantic.text.body}"
            },
            "border": {
              "$scopes": ["STROKE_COLOR"],
              "$type": "color",
              "$value": "rgba(0,0,0,0.15)"
            },
            "item-hover-bg": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "{colors.neutral.gray.100}"
            }
          }
        },
        "Dark": {
          "dropdown": {
            "$value": "{dropdown}",
            "$type": "COMPOSITE",
            "background": { "$type": "color", "$value": "{semantic.background.body}" },
            "text": { "$type": "color", "$value": "{semantic.text.body}" },
            "border": { "$type": "color", "$value": "rgba(255,255,255,0.15)" },
            "item-hover-bg": { "$type": "color", "$value": "{semantic.background.subtle}" }
          }
        }
      }
    }
  }
]
