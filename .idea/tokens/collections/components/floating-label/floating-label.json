[
  {
    "Components | Floating Label": {
      "modes": {
        "Light": {
          "floating-label": {
            "label-opacity": { "$scopes": ["OPACITY"], "$type": "float", "$value": 0.65 },
            "label-transform-scale": {
              "$scopes": ["TRANSFORM"],
              "$type": "string",
              "$value": "scale(.85)"
            }
          }
        },
        "Dark": {
          "floating-label": { "$value": "{floating-label}", "$type": "COMPOSITE" }
        }
      }
    }
  }
]
