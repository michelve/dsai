[
  {
    "Components | Switch": {
      "modes": {
        "Light": {
          "switch": {
            "track-bg": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "{colors.neutral.gray.400}"
            },
            "track-checked-bg": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "{colors.theme.primary}"
            },
            "thumb-bg": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "{colors.neutral.white}"
            }
          }
        },
        "Dark": {
          "switch": {
            "$value": "{switch}",
            "$type": "COMPOSITE",
            "track-bg": { "$type": "color", "$value": "{colors.neutral.gray.600}" },
            "thumb-bg": { "$type": "color", "$value": "{colors.neutral.gray.200}" }
          }
        }
      }
    }
  }
]
