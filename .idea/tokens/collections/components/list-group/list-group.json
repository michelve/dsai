[
  {
    "Components | List Group": {
      "modes": {
        "Light": {
          "list-group": {
            "background": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "{colors.neutral.white}"
            },
            "text": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{semantic.text.body}"
            },
            "border": {
              "$scopes": ["STROKE_COLOR"],
              "$type": "color",
              "$value": "{colors.neutral.gray.200}"
            },
            "active-bg": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "{colors.theme.primary}"
            },
            "active-color": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{colors.neutral.white}"
            },
            "hover-bg": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "{colors.neutral.gray.100}"
            }
          }
        },
        "Dark": {
          "list-group": {
            "$value": "{list-group}",
            "$type": "COMPOSITE",
            "background": { "$type": "color", "$value": "{semantic.background.body}" },
            "text": { "$type": "color", "$value": "{semantic.text.body}" },
            "border": { "$type": "color", "$value": "{semantic.border.default}" },
            "hover-bg": { "$type": "color", "$value": "{semantic.background.subtle}" }
          }
        }
      }
    }
  }
]
