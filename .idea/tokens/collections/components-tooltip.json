[
  {
    "Components | Tooltip": {
      "modes": {
        "Light Mode": {
          "tooltip": {
            "background": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "rgba(0,0,0,.85)"
            },
            "text": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{colors.neutral.white}"
            }
          }
        },
        "Dark Mode": {
          "tooltip": { "$value": "{tooltip}", "$type": "COMPOSITE" }
        }
      }
    }
  }
]
