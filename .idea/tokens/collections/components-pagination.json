[
  {
    "Components | Pagination": {
      "modes": {
        "Light Mode": {
          "pagination": {
            "background": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "{colors.neutral.white}"
            },
            "text": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{semantic.text.link}"
            },
            "border": {
              "$scopes": ["STROKE_COLOR"],
              "$type": "color",
              "$value": "{colors.neutral.gray.300}"
            },
            "active-bg": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "{colors.theme.primary}"
            },
            "active-color": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{colors.neutral.white}"
            },
            "hover-bg": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "{colors.neutral.gray.100}"
            }
          }
        },
        "Dark Mode": {
          "pagination": {
            "$value": "{pagination}",
            "$type": "COMPOSITE",
            "background": { "$type": "color", "$value": "{semantic.background.body}" },
            "text": { "$type": "color", "$value": "{semantic.text.link}" },
            "border": { "$type": "color", "$value": "{semantic.border.default}" },
            "hover-bg": { "$type": "color", "$value": "{semantic.background.subtle}" }
          }
        }
      }
    }
  }
]
