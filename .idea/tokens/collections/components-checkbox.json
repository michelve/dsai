[
  {
    "Components | Checkbox": {
      "modes": {
        "Light Mode": {
          "checkbox": {
            "background": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "{colors.neutral.white}"
            },
            "border": {
              "$scopes": ["STROKE_COLOR"],
              "$type": "color",
              "$value": "{colors.neutral.gray.400}"
            },
            "check-bg": {
              "$scopes": ["ALL_FILLS"],
              "$type": "color",
              "$value": "{colors.theme.primary}"
            },
            "check-icon": {
              "$scopes": ["TEXT_FILL"],
              "$type": "color",
              "$value": "{colors.neutral.white}"
            }
          }
        },
        "Dark Mode": {
          "checkbox": {
            "$value": "{checkbox}",
            "$type": "COMPOSITE",
            "background": { "$type": "color", "$value": "{semantic.background.subtle}" },
            "border": { "$type": "color", "$value": "{semantic.border.default}" }
          }
        }
      }
    }
  }
]
