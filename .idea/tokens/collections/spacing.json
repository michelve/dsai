[
  {
    "Spacing": {
      "modes": {
        "Light Mode": {
          "spacing": {
            "0": { "$scopes": ["GAP", "WIDTH_HEIGHT"], "$type": "float", "$value": 0 },
            "1": { "$scopes": ["GAP", "WIDTH_HEIGHT"], "$type": "float", "$value": 4 },
            "2": { "$scopes": ["GAP", "WIDTH_HEIGHT"], "$type": "float", "$value": 8 },
            "3": { "$scopes": ["GAP", "WIDTH_HEIGHT"], "$type": "float", "$value": 16 },
            "4": { "$scopes": ["GAP", "WIDTH_HEIGHT"], "$type": "float", "$value": 24 },
            "5": { "$scopes": ["GAP", "WIDTH_HEIGHT"], "$type": "float", "$value": 48 }
          }
        },
        "Dark Mode": {
          "spacing": { "$value": "{spacing}", "$type": "COMPOSITE" }
        }
      }
    }
  }
]
