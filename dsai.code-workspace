{
  "folders": [
    {
      "path": "."
    },
    {
      "path": "~/GitHub/dsai-import-tokens",
      "name": "dsai-import-tokens" // optional
    }
  ],
  "settings": {
    // ============================
    // TypeScript Configuration
    // ============================
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "typescript.validate.enable": true,
    "typescript.preferences.importModuleSpecifier": "relative",
    "typescript.updateImportsOnFileMove.enabled": "always",
    "typescript.suggest.autoImports": true,
    "typescript.preferences.quoteStyle": "single",

    // ============================
    // Editor Configuration
    // ============================
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      // Biome: Formatting only (25x faster than Prettier)
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit",
      // ESLint: Linting only (a11y, security, React rules)
      "source.fixAll.eslint": "explicit"
    },
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.rulers": [100, 120],
    "editor.wordWrap": "off",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },

    // ============================
    // File Associations
    // ============================
    "files.associations": {
      "*.css": "css",
      "*.scss": "scss",
      "*.json": "jsonc",
      "*.mjs": "javascript",
      "*.cjs": "javascript"
    },
    "files.exclude": {
      "**/.nx": true,
      "**/node_modules": false
    },
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/build/**": true,
      "**/.nx/**": true,
      "**/storybook-static/**": true,
      "**/coverage/**": true
    },

    // ============================
    // Search Configuration
    // ============================
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/.nx": true,
      "**/coverage": true,
      "**/storybook-static": true,
      "**/pnpm-lock.yaml": true
    },

    // ============================
    // ESLint Configuration (v9 + flat config) - Linting Only
    // ============================
    // ESLint: a11y, security, React hooks, imports, Storybook
    // Biome: formatting
    "eslint.useFlatConfig": true,
    "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
    "eslint.workingDirectories": [{ "mode": "auto" }],
    "eslint.probe": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
    "eslint.format.enable": false,

    // ============================
    // Biome Configuration (Primary Formatter Only)
    // ============================
    // Biome handles: formatting, organize imports
    // ESLint handles: linting rules
    "[javascript]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "[javascriptreact]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "[typescript]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "[json]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "[jsonc]": {
      "editor.defaultFormatter": "biomejs.biome"
    },

    // ============================
    // Prettier Configuration (Fallback)
    // ============================
    "prettier.requireConfig": true,
    "prettier.useEditorConfig": false,
    "[markdown]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[yaml]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },

    // ============================
    // Nx Console
    // ============================
    "nxConsole.enableTelemetry": false,
    "nxConsole.showNodeVersionOnStartup": false,

    // ============================
    // GitHub Copilot
    // ============================
    "github.copilot.enable": {
      "*": true,
      "yaml": true,
      "plaintext": false,
      "markdown": true
    },

    // ============================
    // Testing Configuration
    // ============================
    "jest.autoRun": "off",
    "jest.showCoverageOnLoad": false,

    // ============================
    // Problems Panel
    // ============================
    "problems.excludePatterns": {
      "**/node_modules/**": true
    },

    // ============================
    // Terminal Configuration
    // ============================
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.cwd": "${workspaceFolder}",

    // ============================
    // Git Configuration
    // ============================
    "git.ignoreLimitWarning": true,
    "git.autofetch": true,

    // ============================
    // Spelling Configuration
    // ============================
    "cSpell.words": [
      "autodocs",
      "circlehollow",
      "Codacy",
      "describedby",
      "dsai",
      "eslint",
      "labelledby",
      "Navbars",
      "Noninteractive",
      "pnpm",
      "storybook",
      "subcomponent",
      "subcomponents",
      "subkey",
      "tokens",
      "WCAG",
      "zindex"
    ]
  },
  "extensions": {
    "recommendations": [
      // Essential
      "nrwl.angular-console",
      "biomejs.biome",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",

      // TypeScript
      "yoavbls.pretty-ts-errors",

      // Testing
      "orta.vscode-jest",

      // Git
      "eamodio.gitlens",

      // Documentation
      "yzhang.markdown-all-in-one",

      // Utilities
      "christian-kohler.path-intellisense",
      "streetsidesoftware.code-spell-checker",

      // GitHub
      "github.copilot",
      "github.copilot-chat",

      // Figma
      "figma.figma-vscode-extension"
    ],
    "unwantedRecommendations": ["hookyqr.beautify", "esbenp.prettier-vscode"]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug Jest Tests",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "pnpm",
        "runtimeArgs": ["test", "--runInBand", "--no-cache"],
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen"
      },
      {
        "name": "Debug Current Jest Test",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "pnpm",
        "runtimeArgs": ["test", "${fileBasenameNoExtension}", "--runInBand", "--no-cache"],
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Install Dependencies",
        "type": "shell",
        "command": "pnpm install",
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Build All",
        "type": "shell",
        "command": "pnpm build",
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        }
      },
      {
        "label": "Test All",
        "type": "shell",
        "command": "pnpm test",
        "group": {
          "kind": "test",
          "isDefault": true
        },
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        }
      },
      {
        "label": "Test with Coverage",
        "type": "shell",
        "command": "pnpm test:coverage",
        "group": "test",
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      },
      {
        "label": "Lint All",
        "type": "shell",
        "command": "pnpm lint",
        "group": "test",
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        }
      },
      {
        "label": "Storybook",
        "type": "shell",
        "command": "pnpm --filter @dsai/storybook storybook",
        "isBackground": true,
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      },
      {
        "label": "Nx Graph",
        "type": "shell",
        "command": "pnpm graph",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      }
    ]
  }
}
