# Default — all files use LF
* text=auto eol=lf

# Explicitly LF
*.js        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.py        text eol=lf
*.sh        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.toml      text eol=lf
*.env       text eol=lf

# Binary — never convert
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.otf       binary
*.mp4       binary
*.webp      binary
