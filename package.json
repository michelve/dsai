{
  "name": "@dsai-io/source",
  "version": "1.0.1",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "nx run-many --target=dev --all",
    "build": "nx run-many --target=build --all",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "coverage:upload": "dotenv -e .env -- sh -c 'curl -Ls https://coverage.codacy.com/get.sh | bash -s report -r coverage/lcov.info --commit-uuid $(git rev-parse HEAD)'",
    "test:nx": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "affected:build": "nx affected --target=build",
    "affected:test": "nx affected --target=test",
    "graph": "nx graph",
    "prepare": "husky",
    "tokens:transform": "dsai tokens build",
    "tokens:validate": "dsai tokens validate",
    "tokens:build": "dsai tokens build && dsai tokens validate",
    "analyze:buttons": "node tools/scripts/analysis/analyze-button-usage.cjs",
    "figma:connect": "figma connect",
    "figma:publish": "figma connect publish",
    "figma:publish:dry": "figma connect publish --dry-run"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@dsai-io/tools": "workspace:*",
    "@biomejs/biome": "^2.3.11",
    "@eslint/js": "^9.39.1",
    "@figma/code-connect": "^1.4.2",
    "@nx/eslint": "22.6.1",
    "@nx/jest": "22.6.1",
    "@nx/js": "22.6.1",
    "@nx/storybook": "22.6.1",
    "@nx/vite": "22.6.1",
    "@nx/workspace": "22.6.1",
    "@storybook/addon-docs": "^10.3.1",
    "@storybook/addon-vitest": "^10.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitest/browser-playwright": "^4.0.17",
    "autoprefixer": "^10.4.23",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-storybook": "^10.3.1",
    "fast-check": "^4.5.3",
    "globals": "^17.0.0",
    "gzip-size-cli": "^5.1.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-watch-typeahead": "^3.0.1",
    "lint-staged": "^16.2.7",
    "nx": "22.6.1",
    "postcss": "^8.5.6",
    "prettier": "^3.8.0",
    "storybook": "^10.3.1",
    "ts-jest": "^29.4.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "pnpm": {
    "overrides": {
      "axios": ">=1.13.5",
      "minimatch": ">=10.2.3",
      "test-exclude>minimatch": "^3.1.2",
      "eslint-plugin-jsx-a11y>minimatch": "^3.1.2",
      "rollup": ">=4.59.0",
      "ajv": ">=8.18.0",
      "eslint>ajv": "^6.12.6",
      "@eslint/eslintrc>ajv": "^6.12.6",
      "flatted": ">=3.4.2",
      "qs": ">=6.14.2",
      "svgo": ">=4.0.1",
      "immutable": ">=5.1.5",
      "undici": ">=6.24.0",
      "picomatch": ">=4.0.4",
      "micromatch>picomatch": "^2.3.1",
      "yaml": ">=2.8.3",
      "cosmiconfig>yaml": "^1.10.2"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
