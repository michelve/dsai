    "gzip-size-cli": "^5.1.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-watch-typeahead": "^3.0.1",
    "lint-staged": "^16.2.6",
    "nx": "22.0.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "storybook": "^10.0.8",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2"
  }
