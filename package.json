{
  "name": "@dsai/source",
  "version": "1.0.1",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nx run-many --target=dev --all",
    "build": "nx run-many --target=build --all",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "coverage:upload": "dotenv -e .env -- sh -c 'curl -Ls https://coverage.codacy.com/get.sh | bash -s report -r coverage/lcov.info --commit-uuid $(git rev-parse HEAD)'",
    "test:nx": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "affected:build": "nx affected --target=build",
    "affected:test": "nx affected --target=test",
    "graph": "nx graph",
    "prepare": "husky",
    "tokens:transform": "dsai tokens build",
    "tokens:validate": "dsai tokens validate",
    "tokens:build": "dsai tokens build && dsai tokens validate",
    "analyze:buttons": "node tools/scripts/analysis/analyze-button-usage.cjs",
    "figma:connect": "figma connect",
    "figma:publish": "figma connect publish",
    "figma:publish:dry": "figma connect publish --dry-run"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@eslint/js": "^9.39.1",
    "@figma/code-connect": "^1.3.0",
    "@nx/eslint": "22.1.3",
    "@nx/jest": "22.1.3",
    "@nx/js": "22.1.3",
    "@nx/storybook": "22.1.3",
    "@nx/vite": "22.1.3",
    "@nx/workspace": "22.1.3",
    "@storybook/addon-docs": "^10.1.10",
    "@storybook/addon-vitest": "^10.1.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/browser-playwright": "^4.0.15",
    "autoprefixer": "^10.4.21",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-storybook": "^10.1.10",
    "fast-check": "^4.4.0",
    "globals": "^16.5.0",
    "gzip-size-cli": "^5.1.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-watch-typeahead": "^3.0.1",
    "lint-staged": "^16.2.6",
    "nx": "22.1.3",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "storybook": "^10.1.10",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
