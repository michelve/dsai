{
  "name": "playground",
  "version": "0.0.1",
  "description": "Development playground for testing DSAi components and building custom tokens",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "figma:fetch": "node --env-file=.env figma.config.mjs export",
    "figma:sync": "node --env-file=.env figma.config.mjs sync",
    "figma:info": "node --env-file=.env figma.config.mjs info",
    "figma:workflow": "node --env-file=.env figma.config.mjs workflow",
    "tokens:transform": "node ../../packages/@dsai-io/tools/bin/dsai-tools.mjs tokens transform",
    "tokens:build": "node ../../packages/@dsai-io/tools/bin/dsai-tools.mjs tokens build",
    "tokens:build:full": "node ../../packages/@dsai-io/tools/bin/dsai-tools.mjs tokens build --clean",
    "tokens:build:fast": "node ../../packages/@dsai-io/tools/bin/dsai-tools.mjs tokens build --quiet",
    "tokens:list-themes": "node ../../packages/@dsai-io/tools/bin/dsai-tools.mjs tokens build --list-themes",
    "tokens:validate": "node ../../packages/@dsai-io/tools/bin/dsai-tools.mjs tokens validate",
    "tokens:changelog": "node ../../packages/@dsai-io/tools/bin/dsai-tools.mjs tokens changelog",
    "tokens:watch": "node ../../packages/@dsai-io/tools/bin/dsai-tools.mjs tokens build --watch",
    "tokens:all": "pnpm tokens:transform && pnpm tokens:build",
    "tokens:full": "pnpm figma:fetch && pnpm tokens:all"
  },
  "dependencies": {
    "@dsai-io/figma-tokens": "workspace:*",
    "@dsai-io/react": "workspace:*",
    "@dsai-io/tools": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "bootstrap": "^5.3.8",
    "glob": "^11.0.2",
    "sass": "^1.77.8",
    "style-dictionary": "^5.1.4",
    "vite": "^7.2.6"
  },
  "license": "AGPL-3.0-or-later"
}
