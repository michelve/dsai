{
  // ============================
  // Editor
  // ============================
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "biomejs.biome",
  "editor.codeActionsOnSave": {
    // Biome: Formatting only (fast)
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit",
    // ESLint: Linting only (comprehensive rules)
    "source.fixAll.eslint": "explicit"
  },
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.rulers": [100, 120],
  "editor.wordWrap": "off",

  // Strong recommendations to prevent noisy suggestions
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": true
  },

  // ============================
  // TypeScript
  // ============================
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.preferences.quoteStyle": "single",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.suggest.autoImports": true,
  "typescript.validate.enable": true,

  // ============================
  // ESLint (v9 + flat config) - Linting Only
  // ============================
  // ESLint handles: a11y, security, React rules, imports, custom rules
  // Biome handles: formatting
  "eslint.useFlatConfig": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "eslint.probe": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "eslint.format.enable": false,

  // ============================
  // Biome (Primary Formatter) - 25x Faster than Prettier
  // ============================
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },

  // ============================
  // Prettier (Fallback for non-JS/TS files)
  // ============================
  "prettier.requireConfig": true,
  "prettier.useEditorConfig": false,
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // ============================
  // File Associations
  // ============================
  "files.associations": {
    "*.css": "css",
    "*.scss": "scss",
    "*.json": "jsonc",
    "*.mjs": "javascript",
    "*.cjs": "javascript"
  },

  // Hide generated / heavy folders
  "files.exclude": {
    "**/.nx": true
  },

  // ============================
  // Problems Panel
  // ============================
  "problems.excludePatterns": {
    "**/node_modules/**": true
  },

  // ============================
  // File Watching / Search
  // ============================
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.nx": true,
    "**/coverage": true,
    "**/storybook-static": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.nx/**": true,
    "**/storybook-static/**": true
  },

  // ============================
  // Nx Console
  // ============================
  "nxConsole.enableTelemetry": false,
  "nxConsole.showNodeVersionOnStartup": false,

  // ============================
  // Testing
  // ============================
  "jest.autoRun": "off",
  "jest.showCoverageOnLoad": false,

  // ============================
  // GitHub Copilot
  // ============================
  "github.copilot.enable": {
    "*": true,
    "yaml": true,
    "plaintext": false,
    "markdown": true
  },

  // ============================
  // Terminal
  // ============================
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.cwd": "${workspaceFolder}",

  // ============================
  // Git
  // ============================
  "git.ignoreLimitWarning": true,
  "git.autofetch": true,

  // ============================
  // Spelling
  // ============================
  "cSpell.words": [
    "autodocs",
    "circlehollow",
    "Codacy",
    "describedby",
    "dsai",
    "eslint",
    "labelledby",
    "Navbars",
    "Noninteractive",
    "pnpm",
    "storybook",
    "subcomponent",
    "subcomponents",
    "subkey",
    "tokens",
    "WCAG",
    "zindex"
  ],

  // ============================
  // Sass Compiler (disabled – build uses pnpm)
  // ============================
  "liveSassCompile.settings.autoCompile": false
}
