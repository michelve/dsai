{
  // ============================
  // Editor
  // ============================
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    // Use explicit so fixes only run when you trigger "Format Document" or similar.
    // If you want auto-fix on every save, change "explicit" → true.
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,

  // Strong recommendations to prevent noisy suggestions
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": true
  },

  // ============================
  // TypeScript
  // ============================
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.suggest.autoImports": true,
  "typescript.validate.enable": true,

  // ============================
  // ESLint (v9 + flat config)
  // ============================
  "eslint.useFlatConfig": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "eslint.probe": ["javascript", "javascriptreact", "typescript", "typescriptreact"],

  // ============================
  // Prettier
  // ============================
  "prettier.requireConfig": true,
  "prettier.useEditorConfig": false,

  // ============================
  // File Associations
  // ============================
  "files.associations": {
    "*.css": "css",
    "*.scss": "scss",
    "*.json": "jsonc",
    "*.mjs": "javascript",
    "*.cjs": "javascript"
  },

  // Hide generated / heavy folders
  "files.exclude": {
    "**/.nx": true
  },

  // ============================
  // Problems Panel
  // ============================
  "problems.excludePatterns": {
    "**/node_modules/**": true
  },

  // ============================
  // File Watching / Search
  // ============================
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.nx": true,
    "**/coverage": true,
    "**/storybook-static": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.nx/**": true,
    "**/storybook-static/**": true
  },

  // ============================
  // Nx Console
  // ============================
  "nxConsole.enableTelemetry": false,
  "nxConsole.showNodeVersionOnStartup": false,

  // ============================
  // Spelling
  // ============================
  "cSpell.words": [
    "autodocs",
    "circlehollow",
    "Codacy",
    "describedby",
    "dsai",
    "eslint",
    "labelledby",
    "Navbars",
    "Noninteractive",
    "pnpm",
    "storybook",
    "subcomponent",
    "subcomponents",
    "subkey",
    "tokens",
    "WCAG",
    "zindex"
  ],

  // ============================
  // Sass Compiler (disabled – build uses pnpm)
  // ============================
  "liveSassCompile.settings.autoCompile": false
}
