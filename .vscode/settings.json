{
  // ============================
  // Editor
  // ============================
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    // Runs ESLint + Prettier as the final authority
    "source.fixAll": "explicit",
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,

  // Strong recommendations to prevent Codacy issues
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": true
  },

  // ============================
  // TypeScript
  // ============================
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.suggest.autoImports": true,
  "typescript.validate.enable": true,

  // ============================
  // ESLint
  // ============================
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  // Makes ESLint work properly in Nx monorepos
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "eslint.probe": ["javascript", "javascriptreact", "typescript", "typescriptreact"],

  // Required to ensure ESLint + Prettier combo works
  "prettier.requireConfig": true,
  "prettier.useEditorConfig": false,

  // ============================
  // File Associations
  // ============================
  "files.associations": {
    "*.css": "css",
    "*.scss": "scss",
    "*.json": "jsonc",
    "*.mjs": "javascript",
    "*.cjs": "javascript"
  },

  // Prevent VS Code from choking on Nx monorepo output
  "files.exclude": {
    "**/.nx": true
  },

  // ============================
  // File Watching / Search
  // ============================
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.nx": true,
    "**/coverage": true,
    "**/storybook-static": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.nx/**": true,
    "**/storybook-static/**": true
  },

  // ============================
  // Nx Console
  // ============================
  "nxConsole.enableTelemetry": false,
  "nxConsole.showNodeVersionOnStartup": false,

  // ============================
  // Spelling
  // ============================
  "cSpell.words": ["dsai", "subcomponents", "zindex", "storybook", "tokens", "eslint", "pnpm"],

  // ============================
  // Sass Compiler (disabled – build uses pnpm)
  // ============================
  "liveSassCompile.settings.autoCompile": false
}
